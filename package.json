{
  "name": "workmate-cost-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test": "npm run build && npm run runtime:build && npm run test:unit",
    "runtime:install": "npm ci --prefix runtime",
    "runtime:build": "npm ci --prefix runtime --no-audit --no-fund && npm run package --prefix runtime",
    "runtime:test": "npm test --prefix runtime",
    "gateway:test": "node --test gateway-tool/index.node-test.mjs",
    "cdk:synth": "npm run build && npm run runtime:build && cdk synth",
    "cdk:diff": "npm run build && npm run runtime:build && cdk diff WorkmateCostControlStack",
    "deploy": "npm run build && npm run runtime:build && cdk deploy WorkmateCostControlStack --require-approval never",
    "destroy": "cdk destroy WorkmateCostControlStack",
    "cognito:user:create": "node scripts/manage-cognito-user.mjs create",
    "cognito:user:set-password": "node scripts/manage-cognito-user.mjs set-password",
    "cognito:user:set-limit-profile": "node scripts/manage-cognito-user.mjs set-limit-profile",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run runtime:test && npm run gateway:test && cdk synth"
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.57",
    "@ag-ui/core": "^0.0.57",
    "@assistant-ui/react": "^0.15.2",
    "@assistant-ui/react-ag-ui": "^0.0.49",
    "@assistant-ui/react-markdown": "^0.14.8",
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "aws-amplify": "^6.15.8",
    "beautiful-mermaid": "^1.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "aws-cdk": "2.1136.0",
    "aws-cdk-lib": "2.265.0",
    "constructs": "10.8.1",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "vite": "^7.3.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
