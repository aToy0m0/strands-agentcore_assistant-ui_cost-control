{
  "profile": "cdkdep",
  "region": "us-east-1",
  "defaultCdkPrefix": "Agent-Core-Runtime_Cost-control-US",
  "runtimeDisplayName": "AIエージェント",
  "webDebugMode": "off",
  "customDomainEnabled": false,
  "allowCrossRegionKnowledgeBases": false,
  "knowledgeBases": [
    {
      "key": "internal-documents",
      "enabled": true,
      "region": "us-east-1",
      "knowledgeBaseId": "ABCDEFGHIJ",
